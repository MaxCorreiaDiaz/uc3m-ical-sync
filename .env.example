# ══════════════════════════════════════════════════════════════════════════════
#  uc3m-ical-sync — .env del stack (en Dockge: pestaña ".env")
#  Solo las 3 primeras son obligatorias; el resto tiene valores por defecto.
# ══════════════════════════════════════════════════════════════════════════════

# Token secreto de la URL del feed. Genéralo con:  openssl rand -hex 24
FEED_TOKEN=

# NIA (100xxxxxx) y contraseña del SSO de la UC3M
UC3M_USER=
UC3M_PASS=

# ── Recomendado ──────────────────────────────────────────────────────────────
# URL exacta del enlace iCal del portal de horarios (…verHorario.page?exp=…&per=…&fmt=ics).
# Si se deja vacía, se usa el primer enlace .ics que aparezca en el portal.
UC3M_ICS_URL=

# Alertas por Telegram (bot de @BotFather; tu chat id con @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Opcional (valores por defecto entre paréntesis) ──────────────────────────
# DISCORD_WEBHOOK_URL=            # alternativa/adicional a Telegram
# HEALTHCHECK_PING_URL=           # p. ej. https://hc-ping.com/<uuid> (avisa si el servidor cae)
# WEB_BIND=127.0.0.1:8088         # dónde escucha el feed para tu nginx
# SYNC_CRON=0 4 * * *             # hora de sincronización (Europe/Madrid)
# CALENDAR_NAME=Horario UC3M
# NOTIFY_ON_CHANGE=true           # avisar de cambios de aula/horario
# UC3M_EXP= / UC3M_PER=           # alternativa a UC3M_ICS_URL
# MIN_EVENT_RATIO=0.2             # no publica si pierde >80 % de los eventos de golpe
# ALLOW_SHRINK=false
# SYNC_MAX_ATTEMPTS=4
# REFRESH_INTERVAL_HOURS=6
# LOG_LEVEL=INFO
# Selectores del formulario, solo si la UC3M cambia su login (calibrar con --discover):
# UC3M_USERNAME_SELECTOR= / UC3M_PASSWORD_SELECTOR= / UC3M_SUBMIT_SELECTOR=
